{
  "name": "@lyra-protocol/record",
  "version": "0.1.0",
  "description": "Permanent, publicly verifiable trade ledger for autonomous trading agents. Writes to Arweave through Irys.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "lyra-record": "./dist/cli/lyra-record.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "cli",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyra-protocol/lyra-record.git"
  },
  "homepage": "https://github.com/lyra-protocol/lyra-record#readme",
  "keywords": [
    "arweave",
    "irys",
    "trading",
    "ledger",
    "verifiable",
    "provenance",
    "hyperliquid",
    "agent"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "LYRA_LIVE_TESTS=1 vitest run",
    "test:watch": "vitest",
    "cli": "node --experimental-strip-types cli/lyra-record.ts",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@irys/bundles": "^0.0.3",
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.1.8",
    "@noble/curves": "^1.9.7",
    "base64url": "^3.0.1",
    "bs58": "^6.0.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
